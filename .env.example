# Required: an API key from the game. Create one while logged in with
#   POST /api/me/api-key   (the clear token is only shown once)
GAME_API_KEY=

# Game host. Every path in the OpenAPI spec is relative to this.
GAME_BASE_URL=https://neumann-probe.net

# Optional: protect the panel with HTTP Basic auth (user "panel").
# Leave empty if your reverse proxy / VPN already handles access.
PANEL_PASSWORD=

# Refresh bounds. The panel refreshes sooner when the API says a Manny task
# is due (nextUsefulRefreshDelayMs) or a probe is about to arrive.
MIN_POLL_INTERVAL_SECONDS=10
MAX_POLL_INTERVAL_SECONDS=60

# Share of the rate-limit window that background refreshes leave free for
# orders and fixes (0.3 = 30%).
RATE_RESERVE_FRACTION=0.3
